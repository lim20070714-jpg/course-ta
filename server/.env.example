# 对话模型（任意 OpenAI 兼容接口：DeepSeek / Qwen(DashScope) / Ollama / OpenAI ...）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 题目抽取可单独指定更强的模型（结构化与公式质量更稳）；留空则用 LLM_MODEL
EXTRACT_MODEL=

# 图片描述专用视觉模型（需支持图片输入的多模态模型，如 Qwen/Qwen2.5-VL-32B-Instruct）
# 留空则跳过「图片生成文字描述」这一步：图片仍可上传与查看，只是不参与检索与总结
VISION_MODEL=

# 向量模型（注意：DeepSeek 暂不提供 embeddings 接口，需单独配置）
# 推荐：DashScope text-embedding-v3，或本地 Ollama 的 bge-m3
# 留空则复用上面的 LLM_* 配置
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
