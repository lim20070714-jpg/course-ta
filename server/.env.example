# 对话模型（任意 OpenAI 兼容接口：DeepSeek / Qwen(DashScope) / Ollama / OpenAI ...）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 题目抽取可单独指定更强的模型（结构化与公式质量更稳）；留空则用 LLM_MODEL
EXTRACT_MODEL=

# 图片描述专用视觉模型（需支持图片输入）
# 留空则跳过「图片生成文字描述」这一步：图片仍可上传与查看，只是不参与检索与总结
#
# 视觉模型可以来自**与对话模型不同的服务商**：例如对话继续用 SiliconFlow 的 Qwen，
# 图片理解用 DeepSeek。此时填 VISION_BASE / VISION_KEY 指向 DeepSeek 即可。
# 留空则复用上面的 LLM_API_KEY / LLM_BASE_URL。
#
# DeepSeek 的例子（2026-10 现行）：
#   VISION_MODEL=deepseek-flash
#   VISION_BASE=https://api.deepseek.com/v1
#   VISION_KEY=sk-你的DeepSeek密钥
# 说明：deepseek-flash 支持图像理解，图片按 token 计费（单图上限 1024 tokens），
#      旧的 deepseek-v4-flash-vision-exp 已下线但名字仍可调用。
VISION_MODEL=
VISION_KEY=
VISION_BASE=

# 向量模型（注意：DeepSeek 暂不提供 embeddings 接口，需单独配置）
# 推荐：DashScope text-embedding-v3，或本地 Ollama 的 bge-m3
# 留空则复用上面的 LLM_* 配置
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3

# 检索方式：auto = 向量优先、失败自动退到词频（默认）
#           vector = 只用向量，服务不可用时直接报错
#           keyword = 只用词频，完全不调向量模型（没有 embeddings 额度时用这个）
RETRIEVAL_MODE=auto

# 允许访问 API 的前端来源，逗号分隔；部署到域名后必须改成自己的地址
# 例如：CORS_ORIGINS=https://course.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 关于「自带密钥」（BYOK）----
# 访问者可以在界面「设置」里填自己的 API Key，随请求头发给本服务按次使用、不落库。
# 请求头：X-LLM-API-Key / X-LLM-Base-URL / X-LLM-Model / X-Vision-Model
#         / X-Embedding-API-Key / X-Embedding-Base-URL / X-Embedding-Model
#
# 如果你要把实例开放给别人用，又不想消耗自己的额度：
#   把上面的 LLM_API_KEY 留空。这样服务端没有可消耗的密钥，
#   所有人必须填自己的 Key 才能使用 AI 功能（/api/config 会返回 server_key_configured=false）。
#   注意：LLM_API_KEY 为空时，向量模型也需要访问者自带 Key（会复用同一个 Key）。
